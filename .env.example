PORT=3000

# Security Secret (Auto-generated securely on first run in .studio-data/local.secret or .env)
# Or generate manually: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_SECRET=

# Choose your active AI provider: gemini, openai, claude, or local
AI_PROVIDER=gemini

# API Keys (Optional if using Local LLM / Built-In Engine - NEVER commit .env to GitHub)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local LLM Endpoint (For Built-In Engine, LM Studio, Ollama, Bionic LLM Studio)
# Built-In llama.cpp Engine: drop llama-server (Windows/Linux/macOS) into ./local-engine/bin
# and drop .gguf models into ./local-engine/models
LOCAL_LLM_URL=http://127.0.0.1:1234/v1
LOCAL_LLM_MODEL=default
