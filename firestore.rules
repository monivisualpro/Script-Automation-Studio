rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128;
    }

    // Sole hardcoded platform owner (no dynamic admin promotion allowed)
    function isAdmin() {
      return isSignedIn()
        && ('email' in request.auth.token)
        && request.auth.token.email != null
        && request.auth.token.email.lower() == "tahsinirshad7370@gmail.com";
    }

    function isValidUserDoc(data, userId) {
      return data.keys().hasOnly([
          'userId', 'name', 'email', 'profilePhoto', 'provider',
          'role', 'isAdmin', 'apiKeyMasked', 'hasApiKey', 'encryptedApiKey',
          'modelSettings', 'imageHistory', 'createdAt', 'updatedAt'
        ])
        && (!('userId' in data) || (data.userId is string && data.userId == userId && data.userId.size() <= 128))
        && (!('name' in data) || (data.name is string && data.name.size() <= 120))
        && (!('email' in data) || (data.email is string && data.email.size() <= 254))
        && (!('profilePhoto' in data) || (data.profilePhoto is string && data.profilePhoto.size() <= 1024))
        && (!('provider' in data) || (data.provider is string && data.provider.size() <= 64))
        && (!('role' in data) || (data.role in ['user', 'admin']))
        && (!('isAdmin' in data) || (data.isAdmin is bool))
        && (!('apiKeyMasked' in data) || data.apiKeyMasked == null || (data.apiKeyMasked is string && data.apiKeyMasked.size() <= 64))
        && (!('hasApiKey' in data) || (data.hasApiKey is bool))
        && (!('encryptedApiKey' in data) || data.encryptedApiKey == null || (data.encryptedApiKey is string && data.encryptedApiKey.size() <= 2048))
        && (!('modelSettings' in data) || (data.modelSettings is map && data.modelSettings.keys().size() <= 20))
        && (!('imageHistory' in data) || (data.imageHistory is list && data.imageHistory.size() <= 50))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    match /users/{userId} {
      // Get: Individual user profile read - document owner or platform admin
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      // List: Platform admin can query and list the entire user directory
      allow list: if isAdmin();

      // Writes: Document owner can create their own profile; Admin can initialize user profiles
      allow create: if isSignedIn()
        && isValidId(userId)
        && (request.auth.uid == userId || isAdmin())
        && request.resource.data.keys().hasAll(['userId', 'email', 'role'])
        && isValidUserDoc(request.resource.data, userId)
        && (
          isAdmin() || (
            request.resource.data.role == 'user'
            && (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false)
          )
        );

      allow update: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserDoc(request.resource.data, userId)
        && (!('createdAt' in request.resource.data) || !('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
        && (
          isAdmin() || (
            (!('role' in request.resource.data) || request.resource.data.role == 'user')
            && (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false)
          )
        );

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    // Dynamic admin promotion collection is permanently locked
    match /admins/{userId} {
      allow read, write: if false;
    }
  }
}
